# This file is a placeholder for environment variables required to run this project.

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

# Resend API Key for contact form emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional: sender address for contact form notifications.
# Defaults to Portfolio <onboarding@resend.dev> (Resend test domain, only delivers to you).
# Set it to a verified domain once you own one, e.g. Portfolio <contact@yourdomain.com>
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: where contact form notifications are delivered.
# Defaults to andypratama1211@gmail.com
# CONTACT_TO_EMAIL=andypratama1211@gmail.com
